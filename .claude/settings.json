{
  "permissions": {
    "deny": [
      "Read(./config/master.key)",
      "Read(./config/credentials/*.key)",
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"$CLAUDE_PROJECT_DIR/.claude/hooks/rubocop_autocorrect.rb\""
          }
        ]
      }
    ]
  }
}
